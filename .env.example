# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Google Sheets (topic queue) ---
GOOGLE_SHEET_ID=

# --- Google OAuth 2.0 (Desktop) — shared by Sheets + YouTube ---
# Service-account keys are blocked by some Workspace orgs, so the pipeline
# authenticates with an OAuth 2.0 Desktop client. Create one in Google Cloud
# Console (APIs & Services > Credentials > OAuth client ID > Desktop app),
# enable the Google Sheets API and YouTube Data API v3, and download the JSON.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Path to the downloaded Desktop client secret JSON
YOUTUBE_CLIENT_SECRET_PATH=credentials/client_secret.json
# Where the authorized-user token is cached after first browser consent.
# A single token covers both Sheets and YouTube scopes.
GOOGLE_SHEETS_CREDS_PATH=credentials/google_oauth_token.json

# --- LinkedIn ---
# Create an app at https://www.linkedin.com/developers/apps with the
# w_member_social scope and redirect URL http://localhost:8080/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
LINKEDIN_SCOPE=w_member_social
# Optional override. If unset, the OAuth flow mints + caches a token.
LINKEDIN_ACCESS_TOKEN=
# Format: urn:li:person:XXXX or urn:li:organization:XXXX (set manually)
LINKEDIN_AUTHOR_URN=

# --- WordPress (blog) ---
WORDPRESS_URL=
WORDPRESS_USER=
# Self-hosted WordPress: Application Password from WP admin, not your login password
WORDPRESS_APP_PASSWORD=
# WordPress.com-hosted sites instead need an OAuth2 token (https://developer.wordpress.com/apps/).
# NOTE: REST API posting on wordpress.com requires a PAID plan (Personal or above)
# or a self-hosted site with Jetpack. Free wordpress.com sites cannot post via the
# API — leave this empty and the blog publisher will skip (exit 0) instead of failing.
WORDPRESS_COM_TOKEN=

# --- Thumbnail generation ---
# Which image provider: stability (default) | openai
# If the selected provider's key is missing/empty, thumbnail generation is
# skipped gracefully (logs a skip, exits 0) so the pipeline isn't blocked.
IMAGE_API=stability
# Stability AI (SDXL v1) — https://platform.stability.ai/account/keys
STABILITY_API_KEY=
OPENAI_API_KEY=

# --- Video assembly (stock b-roll) ---
# Pexels Video API key for stock b-roll cues — https://www.pexels.com/api/
# If empty, b-roll cues fall back to a generated placeholder card.
PEXELS_API_KEY=
