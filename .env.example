# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Google Sheets (topic queue) ---
# Service account JSON, scoped to the topics spreadsheet
GOOGLE_SHEETS_CREDS_PATH=./secrets/google-service-account.json
GOOGLE_SHEET_ID=

# --- YouTube ---
# OAuth client secret JSON downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRET_PATH=./secrets/youtube-client-secret.json

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
# Format: urn:li:person:XXXX or urn:li:organization:XXXX
LINKEDIN_AUTHOR_URN=

# --- WordPress (blog) ---
WORDPRESS_URL=
WORDPRESS_USER=
# Application Password from WP admin, not your login password
WORDPRESS_APP_PASSWORD=

# --- Thumbnail generation ---
# Which image provider: openai | stability
IMAGE_API=openai
OPENAI_API_KEY=
STABILITY_API_KEY=
